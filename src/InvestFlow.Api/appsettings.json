{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=investflow.db"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 30,
      "WindowSeconds": 10
    },
    "Estrito": {
      "PermitLimit": 5,
      "WindowSeconds": 10
    }
  },
  "AllowedHosts": "*"
}
